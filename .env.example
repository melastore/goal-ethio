# football-data.org token, from https://www.football-data.org/client/register
# Only the fetch script reads it, so it never reaches the browser.
FOOTBALL_DATA_TOKEN=

# Only needed if you move to api-football's paid tier, which carries goal events
# (named first scorer and minute). See scripts/fetch-week-apifootball.mjs.
API_FOOTBALL_KEY=

# The site's own origin, for canonical URLs.
NEXT_PUBLIC_SITE_URL=
